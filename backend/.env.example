# Backend environment variables
NODE_ENV=development
PORT=8000

# Frontend origin for CORS (Phase 4 will enforce in production)
CORS_ORIGIN=http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Email (Phase 6)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
ADMIN_EMAIL=

# Database (Phase 7 - Firestore service account JSON path or config)
# Option A: discrete service account fields
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n
# Option B: path to a service-account JSON file
GOOGLE_APPLICATION_CREDENTIALS=

# Option C: inline JSON string for one-off scripts
FIREBASE_SERVICE_ACCOUNT_JSON=
